{
	"schemaVersion": 1,
	"id": "dolphinclient",
	"version": "${version}",
	"name": "DolphinClient",
	"description": "Insanely optimized Minecraft client for Hypixel 1.8.9.",
	"authors": [
		"DSNS"
	],
	"contributors": [
		"moehreag",
		"YakisikliBaran",
		"DragonEggBedrockBreaking",
		"TheKodeToad",
		"CornetPanique86",
		"Mixces"
	],
	"contact": {
		"homepage": "https://github.com/dsnsgithub/DolphinClient/",
		"sources": "https://github.com/dsnsgithub/DolphinClient/",
		"issues": "https://github.com/dsnsgithub/DolphinClient/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/dolphinclient/icon.png",
	"accessWidener": "axolotlclient.classtweaker",
	"environment": "client",
	"entrypoints": {
		"modmenu": [
			"io.github.axolotlclient.config.modmenu.ModMenuCompat"
		]
	},
	"mixins": [
		"axolotlclient.mixins.json",
		"axolotlclient-bridge.mixins.json",
		"oldanimations.mixins.json"
	],
	"provides": [
		"axolotlclient",
		"axolotlclient-oldanimations"
	],
	"custom": {
		"axolotlclient:bridge_impl_version": "V1_8",
		"dolphinclient:bridge_impl_version": "V1_8"
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "1.8.9",
		"osl-resource-loader": "*",
		"osl-lifecycle-events": "*",
		"osl-keybinds": "*",
		"osl-entrypoints": "*",
		"axolotlclientconfig": "*",
		"dolphinclient-common": "*",
		"legacy-lwjgl3": ">=1.4.3"
	}
}
